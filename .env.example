# Copy to .env and fill in. Never commit .env.

# Discogs personal access token (raises API limit from 25 to 60 req/min)
DISCOGS_TOKEN=

# Last.fm API key (non-commercial use)
LASTFM_API_KEY=

# Wikimedia asks API clients to send a descriptive User-Agent with contact details
WIKIMEDIA_USER_AGENT="emerging-sound-radar/0.1 (your-email@example.com)"

# Optional paid layer
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
